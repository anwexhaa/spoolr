{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": false
  },

  "Retry": {
    "BaseDelaySeconds": 1,
    "MaxDelaySeconds": 300,
    "Multiplier": 2,
    "MaxAttempts": 3
  },

  "Dispatch": {
    "DispatchTimeoutSeconds": 60,
    "RequeueDelaySeconds": 5,
    "SweepIntervalSeconds": 30,
    "HeartbeatWindowSeconds": 120
  },

  "ServiceBus": {
    "FullyQualifiedNamespace": "",
    "TopicName": ""
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": ""
  }
}
